.category-page { padding: 32rpx; min-height: 100vh; box-sizing: border-box; }
.tip { font-size: 24rpx; color: #8a7c66; margin-bottom: 24rpx; }
.list { display: flex; flex-direction: column; gap: 20rpx; }
.item { display: flex; justify-content: space-between; align-items: center; background: #fff; border-radius: 16rpx; padding: 30rpx 32rpx; box-shadow: 0 6rpx 24rpx rgba(90,70,40,.06); }
.name { font-size: 30rpx; font-weight: 600; color: #3a342b; }
.count { font-size: 24rpx; color: #b08d57; background: #f3ead7; padding: 4rpx 18rpx; border-radius: 999rpx; }
