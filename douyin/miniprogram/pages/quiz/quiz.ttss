.quiz { padding: 32rpx; background: #f5f1e8; min-height: 100vh; box-sizing: border-box; }
.bar { display: flex; justify-content: space-between; font-size: 26rpx; color: #6b5c48; padding: 0 8rpx 20rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 36rpx 32rpx; box-shadow: 0 6rpx 24rpx rgba(90,70,40,.08); }
.meta { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.tag { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 999rpx; background: #efe6d4; color: #7a5c32; }
.lv { background: #e4e9ef; color: #4a5a70; }
.stem { font-size: 34rpx; line-height: 1.6; color: #2f2a22; margin-bottom: 32rpx; font-weight: 600; }
.options { display: flex; flex-direction: column; gap: 20rpx; }
.opt { display: flex; align-items: flex-start; gap: 20rpx; padding: 24rpx; border: 2rpx solid #e6ddcc; border-radius: 16rpx; background: #fdfbf6; }
.opt .k { width: 44rpx; height: 44rpx; line-height: 44rpx; text-align: center; border-radius: 50%; background: #e9e0cd; color: #6b5c48; font-size: 24rpx; flex: none; }
.opt .t { font-size: 30rpx; line-height: 1.5; color: #3a342b; }
.opt.picked { border-color: #b08d57; }
.opt.right { border-color: #3f9a5a; background: #f0f8f2; }
.opt.right .k { background: #3f9a5a; color: #fff; }
.opt.wrong { border-color: #c0483f; background: #fdf2f1; }
.opt.wrong .k { background: #c0483f; color: #fff; }
.explain { margin-top: 32rpx; border-top: 2rpx dashed #e6ddcc; padding-top: 28rpx; }
.verdict { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; }
.verdict.ok { color: #3f9a5a; }
.verdict.no { color: #c0483f; }
.explain .text { font-size: 28rpx; line-height: 1.75; color: #4a443a; }
.src { margin-top: 20rpx; font-size: 24rpx; line-height: 1.7; color: #8a7c66; background: #faf6ee; padding: 16rpx 20rpx; border-radius: 12rpx; }
.next { margin-top: 36rpx; background: #8a6a3c; color: #fff; border-radius: 999rpx; font-size: 30rpx; }
.next.ghost { margin-top: 20rpx; background: #fff; color: #8a6a3c; border: 2rpx solid #d9c9a8; }
.done { text-align: center; }
.final { font-size: 40rpx; font-weight: 700; color: #8a6a3c; margin-bottom: 24rpx; }
.done .text { text-align: left; }
